{
  "version": 1,
  "description": "Natural-language block sentences with the expected AiBlockResult. Shared by the on-device parser test (M9-02) and the Gemini evals (M9-04). apps are KnownApps ids (or lower-cased installed labels for localOnly cases); days is omitted when the sentence names none; only fields relevant to the type are listed. Eval scripts must skip localOnly cases.",
  "installedApps": [
    {
      "pkg": "com.supercell.clashofclans",
      "label": "Clash of Clans"
    },
    {
      "pkg": "com.zhiliaoapp.musically",
      "label": "TikTok"
    },
    {
      "pkg": "com.discord",
      "label": "Discord"
    }
  ],
  "cases": [
    {
      "sentence": "Instagram 10 min, then lock 1 hour",
      "expected": {
        "type": "cycle",
        "apps": [
          "instagram"
        ],
        "use": 10,
        "rest": 60
      }
    },
    {
      "sentence": "No YouTube on school days 8am–3pm",
      "expected": {
        "type": "schedule",
        "apps": [
          "youtube"
        ],
        "range": "08:00–15:00",
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri"
        ]
      }
    },
    {
      "sentence": "Social media 45 min a day",
      "expected": {
        "type": "limit",
        "apps": [
          "instagram",
          "reddit",
          "x",
          "youtube"
        ],
        "mins": 45,
        "period": "daily"
      }
    },
    {
      "sentence": "Let me use Instagram for 10 minutes, then lock it for an hour",
      "expected": {
        "type": "cycle",
        "apps": [
          "instagram"
        ],
        "use": 10,
        "rest": 60
      }
    },
    {
      "sentence": "Block Reddit for 2 hours",
      "expected": {
        "type": "now",
        "apps": [
          "reddit"
        ],
        "now": 120
      }
    },
    {
      "sentence": "Block YouTube right now for 30 minutes",
      "expected": {
        "type": "now",
        "apps": [
          "youtube"
        ],
        "now": 30
      }
    },
    {
      "sentence": "Lock WhatsApp for the next 45 min",
      "expected": {
        "type": "now",
        "apps": [
          "whatsapp"
        ],
        "now": 45
      }
    },
    {
      "sentence": "YouTube 20 minutes an hour",
      "expected": {
        "type": "limit",
        "apps": [
          "youtube"
        ],
        "mins": 20,
        "period": "hourly"
      }
    },
    {
      "sentence": "Limit Instagram to 1 hour a day",
      "expected": {
        "type": "limit",
        "apps": [
          "instagram"
        ],
        "mins": 60,
        "period": "daily"
      }
    },
    {
      "sentence": "Reddit 30 min per hour",
      "expected": {
        "type": "limit",
        "apps": [
          "reddit"
        ],
        "mins": 30,
        "period": "hourly"
