# Public values the workflows need to log in to GCP and find the Terraform state (output `prod_env` of infra/seed).
# Not secrets: access is limited by the Workload Identity condition (this repository's numeric ID) and the GitHub
# environment `prod`. Forks replace these with their own seed's output.
GCP_PROJECT_ID=vesper-prod-31275
GCP_WIF_PROVIDER=projects/489743177343/locations/global/workloadIdentityPools/github/providers/github
GCP_DEPLOY_SA=tf-deploy@vesper-prod-31275.iam.gserviceaccount.com
GCP_PLAN_SA=tf-plan@vesper-prod-31275.iam.gserviceaccount.com
TF_STATE_BUCKET=vesper-prod-31275-tfstate
