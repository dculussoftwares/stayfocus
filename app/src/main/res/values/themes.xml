<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background is the dark token from the first frame, so there is no white flash. -->
    <style name="Theme.StayFocused" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sf_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.StayFocused.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sf_background</item>
        <item name="postSplashScreenTheme">@style/Theme.StayFocused</item>
    </style>
</resources>
