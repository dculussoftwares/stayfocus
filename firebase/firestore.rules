rules_version = '2';

// Baseline: deny everything. M7-03 replaces this file with the real rules (plan section 7) and their emulator tests.
// Terraform (infra/firebase/firestore.tf) releases this file; a change here shows up as a ruleset diff in the PR plan.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
