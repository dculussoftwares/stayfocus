{
  "name": "stayfocus-functions",
  "private": true,
  "description": "Cloud Functions (2nd gen) for Stay Focused. Built by Actions and deployed by Terraform (infra/firebase/functions.tf); never by the Firebase CLI.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "firebase emulators:exec --only firestore --project demo-stayfocus --config ../firebase.json \"jest --runInBand\"",
    "test:unit": "jest --runInBand"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "firebase-tools": "^15.33.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
