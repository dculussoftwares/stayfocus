</style>

<script>
  import { play } from "../lib/live";

  // Hero: a sentence typed (or tapped) in the hero fills the demo below and builds it.
  const ask = document.querySelector<HTMLFormElement>("[data-ask]");
  const demoForm = document.querySelector<HTMLFormElement>("[data-describe]");
  const demoInput = demoForm?.querySelector<HTMLInputElement>("input");
  const sendToDemo = (text: string) => {
    if (!demoForm || !demoInput || !text.trim()) return;
    demoInput.value = text;
    demoForm.requestSubmit();
  };
  ask?.addEventListener("submit", (event) => {
    event.preventDefault();
    sendToDemo(ask.querySelector("input")?.value ?? "");
  });
  document.querySelectorAll<HTMLButtonElement>("[data-ask-example]").forEach((b) =>
    b.addEventListener("click", () => {
      const input = ask?.querySelector("input");
      if (input) input.value = b.textContent ?? "";
      sendToDemo(b.textContent ?? "");
    }),
  );

  // Permission rows: tap Allow, watch the count.
  const perms = document.querySelector<HTMLElement>("[data-perms]");
  if (perms) {
    const count = perms.querySelector<HTMLElement>("[data-count]");
    const buttons = [...perms.querySelectorAll<HTMLButtonElement>(".perm-allow")];
    const refresh = () => {
      const n = buttons.filter((b) => b.getAttribute("aria-pressed") === "true").length;
      if (count) count.textContent = n === 4 ? "All set. Start using Vesper." : `${n} of 4 allowed`;
    };
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        b.setAttribute("aria-pressed", "true");
        refresh();
      }),
    );
  }

  // Rule bands: each switch turns its band on or off.
  document.querySelectorAll<HTMLElement>("[data-band]").forEach((band) => {
    const button = band.querySelector<HTMLButtonElement>("button");
    button?.addEventListener("click", () => {
      const on = !band.classList.contains("on");
      band.classList.toggle("on", on);
      button.setAttribute("aria-checked", String(on));
    });
  });

  // Kids story: the pinned phone follows the step in view, and each screen plays again as its step comes up.
  const steps = [...document.querySelectorAll<HTMLElement>("[data-step]")];
  const frames = [...document.querySelectorAll<HTMLElement>("[data-frame]")];
  const playFrame = (frame: HTMLElement | undefined) => {
    const screen = frame?.querySelector<HTMLElement>("[data-live]");
    if (screen) play(screen);
  };
  if (steps.length && "IntersectionObserver" in window) {
    let shown = -1;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = Number((entry.target as HTMLElement).dataset.step);
          steps.forEach((s, i) => s.classList.toggle("current", i === index));
          frames.forEach((f, i) => f.classList.toggle("active", i === index));
          if (index !== shown) {
            shown = index;
            playFrame(frames[index]);
          }
        }
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    steps.forEach((s) => observer.observe(s));
    steps[0]?.classList.add("current");
  } else {
    steps.forEach((s) => s.classList.add("current"));
  }
</script>
