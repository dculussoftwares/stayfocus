---
// Shared page shell: SEO meta (title, description, canonical, Open Graph), header, footer and the entrance motion.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer, { type Credit } from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  current?: "home" | "kids" | "privacy" | "delete-account";
  noindex?: boolean;
  /** Structured data (schema.org) for this page. */
  jsonLd?: Record<string, unknown>;
  /** Credit for a found photograph shown on the page. */
  credit?: Credit;
}

const { title, description, current, noindex = false, jsonLd, credit } = Astro.props;
// Pages build as files (privacy.html) but are served at clean URLs (/privacy, see astro.config.mjs).
const path = Astro.url.pathname.replace(/(index)?\.html$/, "");
const canonical = new URL(path, Astro.site);
const image = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/plus-jakarta-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#EDEDEB" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vesper" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <Header current={current} />
    <main>
      <slot />
    </main>
    <Footer credit={credit} />
    <script>
      // Sections rise into place once as they enter. Without script, or with reduced motion, everything is visible.
      const items = document.querySelectorAll<HTMLElement>("[data-rise]");
      if ("IntersectionObserver" in window) {
        const seen = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                seen.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        items.forEach((item) => seen.observe(item));
      } else {
        items.forEach((item) => item.classList.add("in"));
      }
    </script>
  </body>
</html>
