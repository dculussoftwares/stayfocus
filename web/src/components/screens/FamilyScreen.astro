---
// Vesper Family tab (feature/devices): a linked child's phone with today's use by the quarter hour, and the "Link a
// child's phone" card, where a dot travels between the two phones.
import { seeded } from "../../lib/screens";

// 6 AM to midnight in quarter hours; 0 draws a dot (no use).
const rnd = seeded(21);
const bars = Array.from({ length: 70 }, (_, i) => {
  const h = 6 + i / 4;
  if (h >= 7.25 && h < 8) return 0.9 + rnd() * 0.1;
  if (h >= 9.5 && h < 17.5) return 0.15 + ((h - 9.5) / 8) * 0.75 + rnd() * 0.1;
  if (h >= 19 && h < 22.5) return 0.2 + ((h - 19) / 3.5) * 0.5 + rnd() * 0.1;
  return 0;
});
const dots = Array.from({ length: 9 }, (_, i) => [8 + (i % 3) * 8, 21 + Math.floor(i / 3) * 8] as const);
---

<div class="ls-body family">
  <p class="ttl" data-in>Family</p>
  <p class="fa-sub" data-in style="--d:40">Phones you manage</p>
  <p class="fa-this" data-in style="--d:100"><i></i>This phone · Pixel 8 · Parent · 1 linked</p>

  <section class="card fa-kid" data-in style="--d:160">
    <div class="fa-kh">
      <div>
        <p class="n">Aarav's phone</p>
        <p class="s">Pixel 7a · Android 15</p>
      </div>
      <span class="online"><i></i>Online</span>
    </div>
    <div class="fa-stats">
      <div><p>Today</p><b>2h 27m</b></div>
      <div><p>Using now</p><b>YouTube</b></div>
      <div><p>Battery</p><b><span data-count="64" data-from="40" data-delay="500">64</span>%</b></div>
    </div>
    <div class="fa-bars">
      {bars.map((v, i) => (v ? <i style={`--h:${v.toFixed(2)};--d:${500 + i * 14}`} /> : <i class="dot" />))}
    </div>
    <p class="axis"><span>6 AM</span><span>12 PM</span><span>6 PM</span><span>11 PM</span></p>
  </section>

  <section class="brand fa-link" data-in style="--d:240">
    <p class="fa-link-t">Link a<br />child's phone</p>
    <span class="plus white">+</span>
    <svg class="fa-pair" viewBox="0 0 330 120">
      <path class="arc" d="M118 92 Q180 -8 242 92"></path>
      <g class="ph ph-a" transform="translate(76 58)">
        <rect width="40" height="62" rx="11"></rect>
        {dots.map(([x, y]) => <circle cx={x + 4} cy={y} r="2"></circle>)}
      </g>
      <g class="ph ph-b" transform="translate(244 58)">
        <rect width="40" height="62" rx="11"></rect>
        {dots.map(([x, y]) => <circle cx={x + 4} cy={y} r="2"></circle>)}
      </g>
      <g class="trip-x"><g class="trip-y"><circle class="spark-dot" cx="118" cy="92" r="6"></circle></g></g>
    </svg>
  </section>
  <p class="fa-note" data-in style="--d:320">Install Vesper Kids on their phone. It shows a code, and you scan it from here.</p>
</div>
