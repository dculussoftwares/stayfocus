---
// Vesper Kids home (kids/): today's screen time, the persistent "managed by" notice, the parent's rules and Unlink.
// The notice drops in the way a notification arrives.
---

<div class="ls-body kidshome">
  <section class="k-hero brand" data-in>
    <p class="k-today">Today</p>
    <p class="k-big" data-count="72" data-format="clock" data-delay="350" data-dur="1500">1:12</p>
  </section>

  <div class="card k-note" data-in="drop" style="--d:650">
    <p class="k-app"><img src="/favicon.svg" alt="" width="20" height="20" />Vesper Kids · now</p>
    <p class="k-title">This phone is managed by Sam</p>
    <p class="k-sub">Screen time and app use are shared with Sam.</p>
  </div>
  <p class="k-cap" data-in="fade" style="--d:1050">↑ Persistent notification · Required by Play policy</p>

  <p class="k-sect" data-in style="--d:1150">Rules set by Sam</p>
  <div class="card k-rule" data-in style="--d:1250">
    <p>Instagram</p>
    <p class="sub">30 min a day</p>
  </div>
  <div class="card k-rule" data-in style="--d:1350">
    <p>Games</p>
    <p class="sub">Mon–Fri · 08:00–15:00</p>
  </div>
  <p class="k-unlink" data-in="fade" style="--d:1500">Unlink from Sam</p>
</div>
