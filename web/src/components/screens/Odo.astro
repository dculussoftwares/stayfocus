---
// A six-digit pairing code whose digits roll into place like an odometer. The strip ends on the real digit, so the
// code reads correctly before the roll, after it, and without script.
import { seeded } from "../../lib/screens";

interface Props {
  code: string;
  seed?: number;
}
const { code, seed = 3 } = Astro.props;
const rnd = seeded(seed);
const groups = [code.slice(0, 3), code.slice(3)];
---

<span class="odo">
  {
    groups.map((group, g) => (
      <span class="odo-group">
        {[...group].map((digit, j) => {
          const strip = [...Array.from({ length: 6 + g * 3 + j }, () => String(Math.floor(rnd() * 10))), digit];
          return (
            <span class="odo-d" style={`--n:${strip.length};--i:${g * 3 + j}`}>
              <span class="odo-s">
                {strip.map((d) => (
                  <span>{d}</span>
                ))}
              </span>
            </span>
          );
        })}
      </span>
    ))
  }
</span>
