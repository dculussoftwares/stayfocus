---
interface Props {
  current: "home" | "privacy" | "delete-account";
}

const { current } = Astro.props;
const links = [
  { id: "home", href: "/", label: "Home" },
  { id: "privacy", href: "/privacy", label: "Privacy policy" },
  { id: "delete-account", href: "/delete-account", label: "Delete account" },
].filter((link) => link.id !== current);
---

<nav>{links.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
